{
  "name": "serenity-surf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Surf forecast, cyclone swell tracker and 10-year surf history for Serenity Beach, Pondicherry",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:api": "tsx scripts/build-api.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "echarts": "5.6.0",
    "maplibre-gl": "5.24.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  }
}
